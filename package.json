{
  "name": "@aluisio/eslint-config",
  "version": "2.1.0",
  "description": "ESLint config for React and Node.js",
  "private": false,
  "main": "base.mjs",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Aluisio de Avila",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Aluisio/eslint-config.git"
  },
  "keywords": [
    "eslint",
    "react",
    "node",
    "next.js"
  ],
  "files": [
    "*.mjs",
    "*.d.ts",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    "./node": {
      "types": "./node.d.ts",
      "import": "./node.mjs"
    },
    "./react": {
      "types": "./react.d.ts",
      "import": "./react.mjs"
    }
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5"
  },
  "dependencies": {
    "@eslint/compat": "^2.0.0",
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-extended": "^3.0.0",
    "eslint-plugin-import-helpers": "^2.0.1",
    "typescript": "^5.9.3"
  }
}
